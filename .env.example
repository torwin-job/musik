# Single-owner auth (REQUIRED — player refuses to start without these)
MUSIK_PASSWORD=change-me
MUSIK_API_TOKEN=change-me-long-random-token
MUSIK_SESSION_SECRET=change-me-another-random-secret
# MUSIK_SECURE_COOKIE=1   # enable when serving over HTTPS
# MUSIK_AUTH_DISABLED=1   # ONLY local open mode — never on public IP
# MUSIK_CORS_ORIGINS=https://app.example.com  # cross-origin clients; empty = same-origin
# MUSIK_CANDIDATE_POOL_AT=8000  # shortlist queue when N>=this (use 50 to test on small libs)

# Library path on the host (mounted into containers as /music)
MUSIK_LIBRARY=/path/to/music

# Auto-watch library folder: musik watch
# MUSIK_WATCH_DEBOUNCE_SEC=45
# MUSIK_WATCH_CLUSTERS=1
# MUSIK_WATCH_MIXES=1

# Absolute URLs for share radio
# MUSIK_PUBLIC_BASE_URL=https://music.example.com
# MUSIK_FFMPEG=ffmpeg
# MUSIK_SHARE_BITRATE=192k
# MUSIK_SHARE_MAX_LISTENERS=4
# Android/LTE transcode cache
# MUSIK_MOBILE_BITRATE=160k
# MUSIK_MOBILE_FORMAT=aac

# Optional tuning
MUSIK_WORKERS=4
# Faster radio adaptation (defaults also raised in player)
MUSIK_TASTE_ALPHA=0.22
MUSIK_PROFILE_FORMING_AT=3
MUSIK_PROFILE_READY_AT=8
MUSIK_EXPLORE_RATIO=0.15
MUSIK_DISCOVER_EXPLORE=0.35
MUSIK_QUEUE_SIZE=6
# MUSIK_PLAYER_ADDR=0.0.0.0:8787
# MUSIK_PUBLIC_BASE_URL=http://192.168.x.x:8787
# MUSIK_WORKER_URL=http://127.0.0.1:8790
# MUSIK_NEW_TRACK_DAYS=14
# MUSIK_NEW_ALBUM_DAYS=14
# Rebuild all recommendation playlists every night.
# MUSIK_NIGHTLY_MIXES_ENABLED=1
# MUSIK_NIGHTLY_MIXES_HOUR=3
# MUSIK_NIGHTLY_MIXES_TIMEZONE=Europe/Moscow  # IANA timezone; "local" uses host/container TZ
