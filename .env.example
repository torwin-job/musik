# Single-owner auth. Multi-user mode disables the shared password and API token.
# Copy to .env (gitignored) and fill with `openssl rand -hex 32`. Never commit real values.
MUSIK_PASSWORD=
MUSIK_API_TOKEN=
MUSIK_SESSION_SECRET=
# MUSIK_SECURE_COOKIE=1   # enable when serving over HTTPS
# MUSIK_AUTH_DISABLED=1   # ONLY local open mode — never on public IP
# MUSIK_CORS_ORIGINS=https://app.example.com  # cross-origin clients; empty = same-origin

# Optional invite-gated multi-user mode. Leave PASSWORD, API_TOKEN and
# AUTH_DISABLED unset/empty in this mode. HTTPS is required; users sign up with a
# username and password from an invitation link, OIDC is an optional second way.
# MUSIK_MULTI_USER=1
# MUSIK_PUBLIC_BASE_URL=https://music.example.com
# Optional additional HTTPS names serving the same web UI (not a CORS setting).
# MUSIK_AUTH_ALLOWED_ORIGINS=https://music.home.example,https://music.vpn.example:8443
# MUSIK_OIDC_ISSUER=https://identity.example.com/realms/music
# MUSIK_OIDC_CLIENT_ID=musik
# MUSIK_OIDC_CLIENT_SECRET=
# First startup: set a random bootstrap invitation (openssl rand -hex 32).
# MUSIK_BOOTSTRAP_INVITE=
# Open /?invitation=<this secret> within 24 hours, then remove it from .env.

# Database backend. SQLite is the default. For PostgreSQL, put the same URL in
# both player and worker environments; never also set MUSIK_DB_PATH.
# MUSIK_DATABASE_URL=sqlite:////data/db/musik.db
# MUSIK_DATABASE_URL=postgresql://musik@db.example.net/musik?sslmode=require
# MUSIK_DB_PATH=/absolute/path/musik.db  # deprecated SQLite-only alias

# Library path on the host. Compose mounts it read-write at /music for the
# player (plugins write imported audio there) and read-only for the worker.
MUSIK_LIBRARY=/path/to/music

# Plugin manifests and executables. One host directory, same idea as MUSIK_LIBRARY.
# Compose mounts it read-write at /plugins; the player inside the container scans
# /plugins. The image does not download plugins or include a plugin runtime.
# Without Docker, this is the directory the player scans. Unset uses
# $XDG_DATA_HOME/musik/plugins, or ~/.local/share/musik/plugins.
# Several directories (OS path separator) work only outside Compose.
# MUSIK_PLUGIN_DIRS=/path/to/plugins
# Seconds for one plugin import. Default 900.
# MUSIK_PLUGIN_TIMEOUT=900
# Seconds for one plugin search. Default 30, shorter than an import.
# MUSIK_PLUGIN_SEARCH_TIMEOUT=30
# How many plugin processes may run at once. Default 2.
# MUSIK_PLUGIN_CONCURRENCY=2
# Optional Yandex protocol v1 plugin settings; its OAuth token lives beside
# the executable in the plugin directory, not in this file.
# MUSIK_YANDEX_QUALITY=lossless
# MUSIK_YANDEX_API_URL=https://api.music.yandex.net
# MUSIK_YANDEX_TOKEN_FILE=/plugins/token

# Auto-watch library folder: musik watch
# MUSIK_WATCH_DEBOUNCE_SEC=45
# MUSIK_WATCH_CLUSTERS=1
# MUSIK_WATCH_MIXES=1

# Absolute URLs for share radio
# MUSIK_PUBLIC_BASE_URL=https://music.example.com
# Default web interface: original or mozgolika; browsers can switch in Profile.
# MUSIK_UI=original
# MUSIK_FFMPEG=ffmpeg
# MUSIK_SHARE_BITRATE=192k
# MUSIK_SHARE_MAX_LISTENERS=4
# Android/LTE transcode cache
# MUSIK_MOBILE_BITRATE=160k
# MUSIK_MOBILE_FORMAT=aac

# Optional tuning
MUSIK_WORKERS=4
# Воркеры embed: mel-препроцессинг CLAP идёт вне лока инференса, поэтому >1 реально
# параллелит декод на многоядерном хосте (GPU-форвард остаётся сериализованным).
# MUSIK_EMBED_WORKERS=4
# Три точки прослушивания по 30 с (начало/середина/конец) и размер окна, которым
# интервал подаётся в модель. Окно = вход фич-экстрактора CLAP; если поставить больше,
# модель обрежет его до случайных 10 с, а id стратегии в ключе кеша не изменится.
# MUSIK_EMBED_SPAN_SEC=30
# MUSIK_EMBED_SEGMENT_SEC=10
# Faster radio adaptation (defaults also raised in player)
MUSIK_TASTE_ALPHA=0.22
MUSIK_PROFILE_FORMING_AT=3
MUSIK_PROFILE_READY_AT=8
MUSIK_EXPLORE_RATIO=0.15
MUSIK_DISCOVER_EXPLORE=0.35
# MUSIK_EXPLORE_LO=0.10
# MUSIK_EXPLORE_HI=0.40
MUSIK_QUEUE_SIZE=6
# MUSIK_PLAYER_ADDR=0.0.0.0:8787
# MUSIK_PUBLIC_BASE_URL=http://192.168.x.x:8787
# MUSIK_WORKER_URL=http://127.0.0.1:8790
# Development only: serve the Web UI from disk instead of the embedded copy,
# so edits to player/internal/static show up on reload without rebuilding.
# MUSIK_STATIC_DIR=/path/to/musik/player/internal/static
# MUSIK_NEW_TRACK_DAYS=14
# MUSIK_NEW_ALBUM_DAYS=14
# Rebuild all recommendation playlists every night.
# MUSIK_NIGHTLY_MIXES_ENABLED=1
# MUSIK_NIGHTLY_MIXES_HOUR=3
# MUSIK_NIGHTLY_MIXES_TIMEZONE=Europe/Moscow  # IANA timezone; "local" uses host/container TZ

# Prebuilt images (docker-compose.images.yml): whose registry and which build.
# player, worker and migrate must come from the same commit.
# MUSIK_IMAGE_OWNER=torwin-job
# MUSIK_IMAGE_TAG=latest

# Optional bundled PostgreSQL (no public database port). Use a URL-safe hex password.
# COMPOSE_PROFILES=postgres
# MUSIK_POSTGRES_USER=musik
# MUSIK_POSTGRES_DB=musik
# MUSIK_POSTGRES_PASSWORD=<openssl rand -hex 32>
# MUSIK_DATABASE_URL=postgresql://musik:${MUSIK_POSTGRES_PASSWORD}@postgres:5432/musik?sslmode=disable
# Moving existing SQLite data: enable import for the first update. Safe to replay.
# MUSIK_IMPORT_SQLITE=1
# MUSIK_IMPORT_SQLITE_SOURCE=/data/db/musik.db
# MUSIK_WRITERS_STOPPED is set by scripts/update-compose.sh, never set it manually.
