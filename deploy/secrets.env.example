# Copy to secrets.env (gitignored) and fill in.
# NEVER commit secrets.env.

# LXC / SSH
MUSIK_SSH_HOST=192.168.1.100
MUSIK_SSH_USER=root
MUSIK_SSH_PASS=

# Paths on the remote
MUSIK_REMOTE_ROOT=/opt/musik
MUSIK_REMOTE_LIBRARY=/music

# Public hostname (DNS A/AAAA → your server or LAN for temp test)
MUSIK_DOMAIN=music.example.com
# Use https when reverse-proxy + cert are ready; http for LAN-only smoke
MUSIK_PUBLIC_SCHEME=https

# App secrets (generate fresh for the server — do not reuse local change-me)
MUSIK_PASSWORD=
MUSIK_API_TOKEN=
MUSIK_SESSION_SECRET=

# Mobile stream profile (Android LTE) — cached under /data/cache/stream
# MUSIK_MOBILE_BITRATE=160k
# MUSIK_MOBILE_FORMAT=aac
